# forage · 配置模板
# 复制成 .env 或直接 export。全部可选 —— 不配也能跑（只走原查询 BM25）。

# ═══ 查询改写后端（可选，但强烈建议）═══════════════════════════════
# 作用：把中文查询改写成英文关键词，作为【新增一路】参与检索。
# 为什么需要：技术博客大部分是英文站。实测中文查「数据库选型」0 命中，
#             英文查 "database selection" 全中 —— 典型「词汇鸿沟」。
# 实测效果：Recall@10  0.372 → 0.837（+125%），MRR +188%
# ★ 不配也能用：改写器 fail-open，后端不可用就只跑原查询，检索绝不失败。
#
# 任何 OpenAI 兼容的 /chat/completions 端点都可以（SiliconFlow / DeepSeek / OpenAI / 本地 vLLM）
CSKB_REWRITE_BASE_URL=https://api.siliconflow.cn
CSKB_REWRITE_API_KEY=sk-xxxxxxxxxxxxxxxx
CSKB_REWRITE_MODEL=Qwen/Qwen3-8B

# 凭据文件路径（默认去 %LOCALAPPDATA%\hermes\secrets\siliconflow.env 找）
# 里面写 KEY=VALUE，如 SILICONFLOW_API_KEY=sk-...
# CSKB_SECRETS=/path/to/your/secrets.env

# ═══ 数据库位置（可选）═══════════════════════════════════════════
# 默认 data/kb.sqlite（相对仓库根）
# CSKB_DB=/path/to/kb.sqlite
