# forage · 配置模板
#
# 复制成 .env 或直接 export。★ 全部可选 —— 不配也能跑（只走原查询 BM25）。

# ═══ 查询改写后端（可选，但强烈建议）═══════════════════════════════════
#
# 作用：把中文查询改写成英文关键词，作为【新增一路】参与检索。
#
# 为什么需要：技术博客大部分是英文站。实测中文查「数据库选型」0 命中，
#             英文查 "database selection" 全中 —— 典型「词汇鸿沟」。
#
# 实测效果：Recall@10  0.372 → 0.837（+125%），MRR +188%
#
# ★ fail-open：后端不可用就只跑原查询，检索本身绝不失败。
#
# 任何 OpenAI 兼容的 /chat/completions 端点都可以
# （SiliconFlow / DeepSeek / OpenAI / 本地 vLLM / Ollama）
FORAGE_REWRITE_BASE_URL=https://api.siliconflow.cn
FORAGE_REWRITE_API_KEY=sk-your-key-here
FORAGE_REWRITE_MODEL=Qwen/Qwen3-8B

# ═══ 凭据文件（可选，与上面的环境变量等价）═══════════════════════════
#
# 不想把 key 写进 shell 环境就用文件。默认依次查找：
#   ~/.config/forage/secrets.env
#   ~/.forage/secrets.env
#   %LOCALAPPDATA%/hermes/secrets/siliconflow.env
#
# 文件内容形如（两种键名都认）：
#   FORAGE_REWRITE_API_KEY=sk-...
#   SILICONFLOW_API_KEY=sk-...
#
# 也可以直接指定路径：
# FORAGE_SECRETS=/path/to/your/secrets.env

# ═══ 数据库位置（可选）═══════════════════════════════════════════════
#
# 默认 data/kb.sqlite（相对仓库根）
# FORAGE_DB=/path/to/kb.sqlite
